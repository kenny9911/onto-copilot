# ── LLM 网关（OpenAI 兼容）──────────────────────────────────────────
CUSTOM_LLM_BASE_URL=http://your-gateway:3010/v1
CUSTOM_LLM_API_KEY=sk-...

# ── 公网资料检索（可选）────────────────────────────────────────────
# 留空时仍可用 Bing RSS 获取真实链接与搜索摘要；配置 Tavily 后可获得质量更稳定的
# 搜索结果，并允许 `web.read` 通过 Tavily 的固定 extract 端点读取正文。
# 密钥只在服务端使用，不会发给浏览器或写进会话。
# TAVILY_API_KEY=tvly-...

# ── 鉴权（登录门禁）────────────────────────────────────────────────
# 门禁是 fail-closed 的：库里一旦有账号就**自动强制**登录，无需设开关。
# 联网部署请在**创建账号前**就把它设为 1，从首次启动起就锁死（未播种管理员前一切 401）。
# 首个管理员只能用宿主机 CLI 播种：  ontocopilot useradd --admin <用户名>
ONTOCOPILOT_AUTH=0
# 在 HTTPS 后面才置 1；http 上置 1 会让浏览器静默丢弃登录 cookie → 死循环登录。
ONTOCOPILOT_COOKIE_SECURE=0
# 登录 cookie 有效期（小时），默认 7 天。
ONTOCOPILOT_SESSION_TTL_HOURS=168
# 允许的跨域来源（逗号分隔）。默认空 = 仅同源（本项目前后端同进程，通常留空）。
# 带凭证时禁止通配 "*"，会被自动滤掉。
ONTOCOPILOT_CORS_ORIGINS=

# ── Live Browser（匿名真实网页渲染）──────────────────────────────────
# 默认自动发现系统 Google Chrome / Chromium / Microsoft Edge；容器或自定义安装路径可
# 显式指定可执行文件。浏览器使用临时隔离 context，不复用个人 Chrome profile/cookie。
# ONTOCOPILOT_CHROME_PATH=/usr/bin/google-chrome

# 服务监听。**固定下来**：不写死的话每次启动可能换端口，同一台机器上并存好几个
# 实例，浏览器连的是哪一个全靠猜 —— 排查时会一直在验证一个没人用的旧进程。
# 命令行 --port / --host 仍然优先。
ONTOCOPILOT_PORT=8765
# ONTOCOPILOT_HOST=127.0.0.1

# 一次梳理的三道预算闸。默认 15 美元 / 3600 秒 / 500 次工具调用 —— 对"9 份材料
# 切出 200+ 段"这种量级全都不够，而撞上时报错只说"预算耗尽"，不说是哪一维。
# ONTOCOPILOT_USD_CAP=80
# ONTOCOPILOT_RUN_WALLCLOCK_S=14400
# ONTOCOPILOT_RUN_TOOL_CALLS=4000
# ONTOCOPILOT_RUN_TOKENS=8000000

# ── 动态 Harness（P0 安全底座）────────────────────────────────
# 网关全局并发上限：所有真实模型调用（重放不受限）同时在飞的最大数。
# 0 或负数 = 不限（旧行为）。默认 6。
# ONTOCOPILOT_GATEWAY_CONCURRENCY=6
# 单轮材料切段上限：段数即抽取 fan-out 基数（一个 sheet/章节一段，实测每段
# 约 4.5 万 token）。超限拒跑（不静默截断），报错会提示拆分材料或调高本值。
# 0 = 不限。默认 240。
# ONTOCOPILOT_MAX_SEGMENTS=240

# ── 可观测性 / OTel 旁路（可选）────────────────────────────────
# ts/src/kernel/otel.ts 是 459 行的完整实现，已接线到 server/usage.ts:365 与
# server/glue/engagement.ts:167，连真 collector 的接线测试都有
# （ts/test/kernel.otel.wiring.test.ts）。但在这一节存在之前，它没有被写进任何
# 一份文档 —— 一个已完工、已接线、已测的能力，因为没人知道怎么打开而等于不存在。
#
# 不配 endpoint 时 bridgeFromEnv 返回 null，整条链路彻底关掉、零开销。
# 本机起一个收集器看看：
#   docker run -d -p 4318:4318 -p 16686:16686 jaegertracing/all-in-one
#   然后打开 http://127.0.0.1:16686
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
#   （等价别名：ONTOCOPILOT_OTLP_ENDPOINT，两个都读，前者优先）
# OTEL_SERVICE_NAME=ontocopilot
#
# 托管后端的 API key 走 headers，规范格式是 `k1=v1,k2=v2`：
# OTEL_EXPORTER_OTLP_HEADERS=x-api-key=...
#   ↑ 填了这个，span 就带着 runId、节点名、材料类型离开这台机器。
#     这个产品处理的是客户材料，配之前先确认合规。默认只给本机 Jaeger。
#
# 改完要生效：:8765 是 launchd 守护（keepalive），
#   launchctl kickstart -k gui/501/com.ontocopilot.dev.8765
