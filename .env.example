# ── LLM 网关（OpenAI 兼容）──────────────────────────────────────────
CUSTOM_LLM_BASE_URL=http://your-gateway:3010/v1
CUSTOM_LLM_API_KEY=sk-...

# ── 鉴权（登录门禁）────────────────────────────────────────────────
# 门禁是 fail-closed 的：库里一旦有账号就**自动强制**登录，无需设开关。
# 联网部署请在**创建账号前**就把它设为 1，从首次启动起就锁死（未播种管理员前一切 401）。
# 首个管理员只能用宿主机 CLI 播种：  ontocopilot useradd --admin <用户名>
ONTOCOPILOT_AUTH=0
# 在 HTTPS 后面才置 1；http 上置 1 会让浏览器静默丢弃登录 cookie → 死循环登录。
ONTOCOPILOT_COOKIE_SECURE=0
# 登录 cookie 有效期（小时），默认 7 天。
ONTOCOPILOT_SESSION_TTL_HOURS=168
# 允许的跨域来源（逗号分隔）。默认空 = 仅同源（本项目前后端同进程，通常留空）。
# 带凭证时禁止通配 "*"，会被自动滤掉。
ONTOCOPILOT_CORS_ORIGINS=
