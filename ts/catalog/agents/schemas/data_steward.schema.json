              "DOCUMENT",
              "MASTER_DATA",
              "TRANSACTION",
              "DERIVED_DATA"
            ]
          },
          "business_keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "system_of_record": {
            "type": [
              "string",
              "null"
            ]
          },
          "owner_role": {
            "type": [
              "string",
              "null"
            ]
          },
          "lifecycle_states": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
