{
  "name": "ontocopilot-ts",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "OntoCopilot 的 TypeScript 侧。迁移期间与 src/ontocopilot 并存，golden/ 是两边共同的真相。",
  "scripts": {
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "check": "tsc --noEmit && npm run check:catalog",
    "check:catalog": "npx tsx src/catalog/check.ts",
    "update:catalog-golden": "npx tsx tools/update-catalog-golden.ts",
    "build": "tsc && node tools/copy-catalog.mjs",
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "build:ui": "node tools/build-ui.mjs",
    "eval": "tsx src/eval/cli.ts"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.11.2",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@napi-rs/canvas": "^1.0.6",
    "@resvg/resvg-js": "^2.6.2",
    "arquero": "^8.0.3",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "hono": "^4.13.2",
    "node-sql-parser": "^5.4.0",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.23.0",
    "puppeteer-core": "^25.9.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.9.0"
  }
}
